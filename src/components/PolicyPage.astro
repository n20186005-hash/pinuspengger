---
// DESIGN REMINDER — policies are independent, calm field notes: readable sections, direct URLs and no modal interaction.
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "./SiteFooter.astro";
import CookieBanner from "./CookieBanner.astro";
import { SITE_NAME } from "../data/site";
type Props = { lang: "id" | "en"; page: "privacy" | "terms" | "cookies" };
const { lang, page } = Astro.props;
const en = lang === "en";
const home = en ? "/en/" : "/";
const other = en ? "/" : "/en/";
const copy = en ? {
  back: "Back to the guide", locale: "ID", home: "Home", nav: ["Privacy", "Terms", "Cookie settings"],
  privacy: ["Privacy", "This page explains the limited information used to operate this independent guide.", [["Information we use", "We use only what is necessary for the site to operate: basic browsing signals that servers normally receive, essential browser storage, and information that you voluntarily send through a contact method if one is offered."], ["How it is used", "Information may help us maintain the guide, understand broad usage patterns, respond to requests and meet applicable obligations. This project does not sell visitor profiles."], ["Third-party services", "Google Maps is embedded for orientation, and Google Fonts supplies the typefaces. Google Analytics is loaded only after you choose to allow analytics. Those providers apply their own policies to their services."], ["Your choices", "You may change the analytics setting at any time on the Cookie settings page. Rights available to you depend on applicable law and the data actually processed."]]],
  terms: ["Terms of use", "A clear boundary for an independent, non-profit visitor information guide.", [["Independent status", "This site is not the official website of Hutan Pinus Pengger and is not affiliated with the operator, any government agency or a commercial seller."], ["Information only", "Content is provided for general travel preparation. Weather, access, service availability, fees, road conditions and operating arrangements can change. Confirm important details through local or official channels before travelling."], ["Respectful use", "Use the guide without copying its original design or text as your own. Copyright in photographs remains with the respective photographers and rights holders."], ["Liability boundary", "The guide is provided as is. We cannot accept responsibility for losses, delays or decisions based on information that later changes or proves incomplete."]]],
  cookies: ["Cookie settings", "Choose whether this guide may load optional analytics. Essential storage is required for your choice to be remembered.", [["Essential storage", "Always active. It remembers your consent choice and supports the basic operation of this static guide."], ["Analytics", "Optional. When permitted, Google Analytics is used with IP anonymisation requested to understand broad site use. It is not loaded before consent."], ["Preferences", "The guide currently stores only the analytics preference. It does not create an advertising profile or offer personalised advertising."]]], save: "Save my choice", allow: "Allow analytics", decline: "Decline analytics", status: "Current choice"
} : {
  back: "Kembali ke panduan", locale: "EN", home: "Beranda", nav: ["Privasi", "Ketentuan", "Pengaturan cookie"],
  privacy: ["Kebijakan privasi", "Halaman ini menjelaskan informasi terbatas yang digunakan untuk menjalankan panduan independen ini.", [["Informasi yang digunakan", "Kami hanya menggunakan hal yang diperlukan agar situs berfungsi: sinyal penjelajahan dasar yang lazim diterima server, penyimpanan peramban esensial, dan informasi yang Anda kirim secara sukarela melalui sarana kontak apabila tersedia."], ["Cara penggunaan", "Informasi dapat membantu memelihara panduan, memahami pola penggunaan secara luas, menanggapi permintaan, dan memenuhi kewajiban yang berlaku. Proyek ini tidak menjual profil pengunjung."], ["Layanan pihak ketiga", "Google Maps disematkan untuk orientasi dan Google Fonts menyediakan jenis huruf. Google Analytics hanya dimuat setelah Anda memilih mengizinkan analitik. Penyedia tersebut menerapkan kebijakan mereka sendiri pada layanannya."], ["Pilihan Anda", "Anda dapat mengubah pilihan analitik kapan saja pada halaman Pengaturan cookie. Hak yang tersedia bergantung pada hukum yang berlaku dan data yang benar-benar diproses."]]],
  terms: ["Ketentuan penggunaan", "Batas yang jelas untuk panduan informasi pengunjung independen dan non-profit.", [["Status independen", "Situs ini bukan situs resmi Hutan Pinus Pengger dan tidak berafiliasi dengan pengelola, instansi pemerintah, atau penjual komersial mana pun."], ["Untuk informasi saja", "Isi disediakan untuk persiapan perjalanan umum. Cuaca, akses, layanan, biaya, kondisi jalan, dan pengoperasian dapat berubah. Konfirmasi hal penting melalui saluran setempat atau resmi sebelum berangkat."], ["Penggunaan yang menghormati", "Gunakan panduan tanpa menyalin desain atau teks asli sebagai karya sendiri. Hak cipta foto tetap pada fotografer serta pemegang hak masing-masing."], ["Batas tanggung jawab", "Panduan disediakan sebagaimana adanya. Kami tidak dapat bertanggung jawab atas kerugian, keterlambatan, atau keputusan yang didasarkan pada informasi yang berubah atau tidak lengkap."]]],
  cookies: ["Pengaturan cookie", "Pilih apakah panduan ini boleh memuat analitik opsional. Penyimpanan esensial diperlukan agar pilihan Anda dapat diingat.", [["Penyimpanan esensial", "Selalu aktif. Digunakan untuk menyimpan pilihan persetujuan dan mendukung fungsi dasar panduan statis ini."], ["Analitik", "Opsional. Bila diizinkan, Google Analytics digunakan dengan permintaan anonimisasi IP untuk memahami penggunaan situs secara luas. Layanan ini tidak dimuat sebelum persetujuan."], ["Preferensi", "Panduan saat ini hanya menyimpan pilihan analitik. Situs ini tidak membentuk profil iklan atau menawarkan iklan yang dipersonalisasi."]]], save: "Simpan pilihan", allow: "Izinkan analitik", decline: "Tolak analitik", status: "Pilihan saat ini"
};
const [heading, intro, sections] = copy[page] as [string, string, Array<[string, string]>];
---

<BaseLayout title={`${heading} | ${SITE_NAME[lang]}`} description={intro} lang={lang}>
  <header class="policy-header"><a class="brand policy-brand" href={home}><img src="/assets/pinus-pengger-logo.png" alt="" width="48" height="48" /><span><strong>PINUS PENGGER</strong><small>{en ? "independent visitor guide" : "panduan pengunjung independen"}</small></span></a><div><a class="language-link dark" href={`${other}${page === "privacy" ? "privacy" : page === "terms" ? "terms" : "cookies"}`} hreflang={en ? "id" : "en"}>{copy.locale}</a><a class="policy-back" href={home}>← {copy.back}</a></div></header>
  <main class="policy-page"><p class="eyebrow"><span></span> {en ? "INDEPENDENT GUIDE POLICY" : "KEBIJAKAN PANDUAN INDEPENDEN"}</p><h1>{heading}</h1><p class="policy-intro">{intro}</p><div class="policy-toc"><a href="#section-1">01</a><a href="#section-2">02</a><a href="#section-3">03</a>{sections.length > 3 && <a href="#section-4">04</a>}</div><div class="policy-content">{sections.map(([sectionTitle, text], index) => <section id={`section-${index + 1}`}><span>0{index + 1}</span><div><h2>{sectionTitle}</h2><p>{text}</p></div></section>)}</div>{page === "cookies" && <section class="cookie-control" aria-labelledby="cookie-control-title"><p class="eyebrow"><span></span> {copy.status}</p><h2 id="cookie-control-title">{en ? "Set analytics deliberately." : "Atur analitik dengan sadar."}</h2><div class="cookie-choice"><button data-choice="accepted">{copy.allow}</button><button data-choice="rejected">{copy.decline}</button></div><p data-save-status role="status" aria-live="polite"></p><p data-choice-status data-allowed={en ? "Analytics: allowed" : "Analitik: diizinkan"} data-declined={en ? "Analytics: declined" : "Analitik: ditolak"}></p><p><button class="choice-save" data-choice-save>{copy.save}</button></p></section>}</main>
  <SiteFooter lang={lang} />
  <CookieBanner lang={lang} />
  {page === "cookies" && <script is:inline>
    const choiceStatus = document.querySelector('[data-choice-status]');
    let selectedChoice = 'rejected';
    try { selectedChoice = localStorage.getItem('ppg-analytics') === 'accepted' ? 'accepted' : 'rejected'; } catch {}
    const updateChoice = () => { document.querySelectorAll('[data-choice]').forEach(button => button.classList.toggle('is-selected', button.dataset.choice === selectedChoice)); if (choiceStatus) choiceStatus.textContent = selectedChoice === 'accepted' ? choiceStatus.dataset.allowed : choiceStatus.dataset.declined; };
    document.querySelectorAll('[data-choice]').forEach(button => button.addEventListener('click', () => { selectedChoice = button.dataset.choice; updateChoice(); if (selectedChoice === 'rejected') window.dispatchEvent(new CustomEvent('ppg-consent', { detail: 'rejected' })); }));
    document.querySelector('[data-choice-save]')?.addEventListener('click', () => { window.dispatchEvent(new CustomEvent('ppg-consent', { detail: selectedChoice })); updateChoice(); });
    window.addEventListener('ppg-consent-changed', (event) => { selectedChoice = event.detail; updateChoice(); });
    updateChoice();
  </script>}
</BaseLayout>

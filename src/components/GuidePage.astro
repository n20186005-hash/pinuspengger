---
// DESIGN REMINDER — “Pohon Penanda”: build a serious, landscape-led field guide. Real images lead; route coordinates, wood-frame edges and restrained resin-gold markers organise practical knowledge.
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "./SiteFooter.astro";
import CookieBanner from "./CookieBanner.astro";

type Props = { lang: "id" | "en" };
const { lang } = Astro.props;
const en = lang === "en";
const prefix = en ? "/en" : "";
const alternate = en ? "/" : "/en/";
const title = en ? "Hutan Pinus Pengger, Bantul: Hours, Fees & Location" : "Hutan Pinus Pengger Bantul: Jam Buka, Tiket & Lokasi";
const description = en ? "Plan Hutan Pinus Pengger in Terong, Dlingo, Bantul: dated opening hours, location, entry and photo fees to confirm, pine forest and community land art." : "Panduan Hutan Pinus Pengger di Terong, Dlingo, Bantul: lokasi, jam buka menurut peta, tiket dan biaya foto yang perlu dikonfirmasi, hutan pinus serta seni komunitas.";
const siteUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

const c = en ? {
  skip: "Skip to content", brandLabel: "Pinus Pengger Guide — return to top", brandSub: "independent visitor guide",
  nav: ["Explore", "Plan", "Access", "Map & FAQ"], route: "Plan the route", locale: "ID",
  heroKicker: "DLINGO, BANTUL · YOGYAKARTA", hero: "Hutan Pinus <em>Pengger.</em>", heroText: "A hillside field guide for a slower visit through pines, hand-built timber forms and a far-reaching view over Yogyakarta.", start: "Begin the guide", photo: "Public reference photograph · copyright remains with the photographer",
  introKicker: "PINE LANDSCAPE & LOOKOUT", introTitle: "More than a photo backdrop.", introLead: "Pinus Pengger sits in the Dlingo hills, where a pine landscape meets branch-and-timber installations. Its pace is shaped by short paths, changing weather and the city view beyond the trees.", introNote: "Bantul’s public potential map lists the site in Dlingo’s cultural and tourism sector. This independent guide is for preparation, not an operational notice.", introCaption: "Shaded pauses among paths, installations and simple seating.", facts: [["Terong, Dlingo", "Bantul, Yogyakarta"], ["08:00–21:00", "daily Maps listing checked 19 October 2026"], ["1–2 hours", "a practical visiting window"]],
  historyKicker: "PLACE, MEMORY & EVIDENCE", historyTitle: "A forest with more than one <em>chapter.</em>", historyIntro: "Professional interpretation separates what is documented from what is merely repeated. Pinus Pengger’s story is best read through the landscape, the neighbouring villages and the community-built visitor experience—not through unverified folklore.", historyCards: [["The wider Dlingo pine belt", "Kalurahan Terong identifies Pinus Pengger as one of several pine destinations in Kapanewon Dlingo, alongside Mangunan, Becici and Pinus Asri. This helps place the site within a broader upland landscape rather than as an isolated attraction."], ["Community land art, documented in 2022", "A 2022 Visiting Jogja article describes community land art, including the hand-shaped Pancawara work. This is historical documentation, not confirmation that every installation is accessible today."], ["Crafted viewing structures", "Bantul’s public potential map describes pine woodland, city views and artistic photography. Ask staff which paths, platforms and photo services are operating; do not cross barriers."], ["No invented legend", "This guide has not found a citable public source for a specific local legend tied to the site. Rather than turn hearsay into heritage, it leaves oral history open for community-sourced documentation."]],
  highlightsKicker: "THREE WAYS TO READ THE SITE", highlightsTitle: "Follow the light.<br />Respect the <em>slope.</em>", highlights: [["01", "Hillside panorama", "On clearer days, the ridge opens onto the valley and the city below. Cloud, haze and the season determine what can actually be seen."], ["02", "Timber installations", "Official 2022 documentation describes land art including the Pancawara hand. Ask which installations are currently open and follow barriers and staff instructions."], ["03", "A quieter pocket", "Between the viewpoints, seek the shaded paths and pause without blocking circulation or disturbing other visitors."]],
  planKicker: "VISIT WITH CARE", planTitle: "Arrive with a <em>simple plan.</em>", plan: [["◐", "Best window", "Morning can offer softer light and a more measured pace; the city lights draw visitors later in the day. Choose around weather and a safe return journey."], ["⌛", "Time on site", "Allow about 1–2 hours for gentle walking, selected photo points and breaks. Leave a margin if you arrive at a busier time."], ["↗", "Footing & weather", "The terrain has contours and can become slippery. Wear shoes with grip, carry water and stay inside the marked platform boundaries."]],
  practicalKicker: "PRACTICAL FIELD NOTES", practicalTitle: "Before the wheels touch <em>red earth.</em>", priceLabel: "ENTRY REFERENCE", price: "Confirm<br /><em>current fees</em>", priceNote: "Current admission prices have not been verified. Ask about entry, parking, photography and individual installations separately before paying.", cost: ["Vehicle parking", "Selected photo structures or documentation services", "Food, drinks and personal needs"], costNote: "Ask for current prices and conditions before using any service.", facilityKicker: "NEUTRAL FACILITIES GUIDE", facilityTitle: "What to look for—<br />without a sales pitch.", facilities: [["WC", "Toilets & hygiene", "Ask staff about toilet location, water supply and access before relying on them. Bring personal tissues and dispose of waste responsibly."], ["P", "Parking", "Ask staff whether parking is available and confirm its location, capacity and fees. Follow on-site directions."], ["☕", "Food & drinking water", "Look for simple food stalls and beverage options around the site or along the approach road. This guide names no business and does not rate vendors."], ["⌂", "Overnight stays", "For longer trips, search for homestays, guesthouses or hotels in the surrounding settlements and Yogyakarta corridor. Confirm distance, access and late arrival arrangements directly."], ["▣", "Groceries & cash", "Convenience shops, markets or larger stores are more likely along the urban corridor than at the forest edge. Carry water and any essential items before ascending."], ["⛽", "Fuel & charging", "Refuel vehicles and check electric-vehicle range before the hill section. Fuel stations and charging points should be located through current maps rather than assumed from this guide."]],
  accessKicker: "FROM TERMINAL TO RIDGE", accessTitle: "An access plan to read <em>slowly.</em>", routes: [["01", "From Yogyakarta International Airport (YIA)", "Use airport rail, DAMRI, an authorised transfer or other current airport services to reach the Yogyakarta urban area first. Continue the final hill segment by a separately arranged vehicle. Check the airport’s official information for current terminals, operating times and fares."], ["02", "From Adisutjipto or the city", "From the city or the older airport area, city transport can help you reach a practical interchange. A direct public-transport promise to the forest is not made here; plan a final vehicle connection before leaving the urban area."], ["03", "Bus & terminal connections", "Intercity bus passengers can arrive at a Yogyakarta terminal and use Trans Jogja or other city services for the urban section. DIY’s transport department provides route and stop maps; the last segment toward Dlingo still requires a separate connection."], ["04", "Taxi, ride-hailing & motorcycle taxi", "Car taxis, app-based rides and motorcycle taxis can be practical for the final segment. Arrange a return option early, share a clear pickup point and do not assume late-night availability in the hills."], ["05", "Private cars, vans & groups", "The Terong village page says the approach can be used by four-wheeled vehicles and tourism buses. The road still has slopes and bends; use a roadworthy vehicle and adapt to weather, visibility and local instructions."]], travelLabel: "RETURN NOTE", travelTitle: "Set up the ride back before choices narrow.", travelText: "Save the location, maintain battery charge, carry rain protection and agree on a pickup plan. Mountain weather, signal quality and vehicle supply can change without notice.",
  nearbyKicker: "THE WIDER DLINGO FIELD", nearbyTitle: "Dlingo is wider than a single <em>frame.</em>", nearby: [["WITHIN THE PINE BELT", "Mangunan Pine Forest", "Another pine setting for slower walking and shade. Build a route around current access, weather and time rather than trying to fit every stop."], ["RIDGE DIRECTION", "Puncak Becici", "A separate outlook in the wider Dlingo area. Check its own entry, road and operating information before combining visits."], ["PATUK CORRIDOR", "Watu Amben", "The Dlingo–Patuk corridor has several outlook points. Stop only where it is safe and never obstruct the road."], ["NEUTRAL FOOD NOTE", "Local stalls & daily needs", "For meals or supplies, look for stall, café, market, fuel or lodging categories along the approach and city corridor. This guide does not recommend individual businesses."]],
  mapKicker: "YOUR STARTING POINT", mapTitle: "Save the pin.<br /><em>Keep your bearings.</em>", mapText: "Jl. Dlingo–Patuk, Sendangsari, Terong, Dlingo, Bantul 55783. Use the dated pin for orientation; recheck road conditions, weather and transport on the day.", openMap: "Open in Google Maps", faqKicker: "COMMON QUESTIONS", faqTitle: "What people ask<br />before <em>leaving.</em>", faq: [["When is the best time to visit?", "Morning and late afternoon are often more comfortable for light and temperature. Choose around weather, visibility and your return plan."], ["How long should I allow?", "About 1–2 hours is a sensible window for a gentle visit. Add time for queues, weather changes or a small group."], ["Are WC and parking available?", "Ask staff about toilets, parking, capacity and fees before relying on them. The current availability of facilities and photography services has not been verified."], ["Can I get there by public transport?", "Public transport can support the airport-to-city or terminal-to-city section. The final Dlingo hill segment normally needs a separately arranged vehicle."], ["What should I prepare for access?", "Stable footwear, drinking water, a charged phone, rain protection and a confirmed return option are more useful than a fixed schedule."], ["Where can I eat, buy supplies or stay?", "Use current maps to find service categories in the settlements and urban corridor. This non-profit guide intentionally does not endorse particular vendors."], ["What are the hours and ticket prices?", "Google Maps checked on 19 October 2026 lists 08:00–21:00 daily. This does not guarantee night access, every installation or photography services, especially in rain. Current prices are unverified; ask separately about entry, parking and photos."]],
  sourceKicker: "SOURCES & EDITORIAL LIMITS", sourceTitle: "Prepared to help you plan—<br />not to replace <em>local confirmation.</em>", sourceText: "The place context and listed facilities draw on the public pages of Kalurahan Terong and Bantul Regency. Transit context draws on the DIY Transport Department’s Trans Jogja information. Visiting Jogja’s 2022 article documents community land art. Maps checked 19 October 2026 lists 4.5/5 from 27,195 reviews and 08:00–21:00 daily; these are dated listing details, not an operational guarantee. Public ratings, fees, hours, weather and services are dynamic.", sourceLast: "Before every visit, confirm safety conditions, access, prices, weather and operations with the site manager or the relevant official channel."
} : {
  skip: "Lewati ke isi", brandLabel: "Panduan Pinus Pengger — kembali ke awal", brandSub: "panduan pengunjung independen",
  nav: ["Jelajahi", "Rencanakan", "Akses", "Peta & FAQ"], route: "Rencanakan rute", locale: "EN",
  heroKicker: "DLINGO, BANTUL · DI YOGYAKARTA", hero: "Hutan Pinus <em>Pengger.</em>", heroText: "Panduan lereng untuk kunjungan yang lebih pelan—melewati pinus, bentuk kayu buatan tangan, lalu menatap Yogyakarta dari kejauhan.", start: "Mulai menjelajah", photo: "Foto referensi publik · hak cipta pada fotografer",
  introKicker: "KAWASAN PINUS & TITIK PANDANG", introTitle: "Bukan sekadar latar foto.", introLead: "Pinus Pengger berada di perbukitan Dlingo, ketika lanskap pinus bertemu dengan instalasi ranting dan kayu. Ritmenya dibentuk oleh jalur pendek, cuaca yang berubah, dan pandangan kota di balik pepohonan.", introNote: "Peta Potensi Kabupaten Bantul mencatat lokasi ini dalam sektor kebudayaan dan pariwisata Dlingo. Panduan independen ini untuk persiapan, bukan pengumuman operasional.", introCaption: "Jeda teduh di antara jalur, instalasi, dan tempat duduk sederhana.", facts: [["Terong, Dlingo", "Bantul, Yogyakarta"], ["08.00–21.00", "listing Maps setiap hari, diperiksa 19 Oktober 2026"], ["1–2 jam", "waktu kunjungan yang praktis"]],
  historyKicker: "TEMPAT, INGATAN & BUKTI", historyTitle: "Hutan dengan lebih dari satu <em>bab.</em>", historyIntro: "Interpretasi yang profesional membedakan hal yang terdokumentasi dari cerita yang sekadar diulang. Kisah Pinus Pengger lebih baik dibaca melalui lanskap, desa-desa sekitar, dan pengalaman pengunjung yang dibentuk masyarakat—bukan melalui cerita rakyat yang belum terverifikasi.", historyCards: [["Sabuk pinus Dlingo", "Kalurahan Terong menyebut Pinus Pengger sebagai salah satu tujuan pinus di Kapanewon Dlingo, bersama Mangunan, Becici, dan Pinus Asri. Ini menempatkan lokasi dalam lanskap dataran tinggi yang lebih luas, bukan sebagai objek yang berdiri sendiri."], ["Land art komunitas, terdokumentasi 2022", "Artikel Visiting Jogja tahun 2022 menggambarkan land art komunitas, termasuk karya Pancawara berbentuk tangan. Ini dokumentasi historis, bukan konfirmasi bahwa seluruh instalasi dapat diakses hari ini."], ["Struktur pandang buatan tangan", "Peta Potensi Bantul menggambarkan hutan pinus, pandangan kota dan foto artistik. Tanyakan kepada petugas jalur, platform dan layanan foto mana yang beroperasi; jangan melewati pembatas."], ["Tidak mengarang legenda", "Panduan ini belum menemukan sumber publik yang dapat dikutip untuk legenda lokal khusus lokasi. Daripada mengubah kabar lisan menjadi fakta warisan, ruang ini dibiarkan terbuka bagi dokumentasi yang bersumber dari masyarakat."]],
  highlightsKicker: "TIGA CARA MEMBACA KAWASAN", highlightsTitle: "Ikuti cahaya.<br />Hormati <em>lerengnya.</em>", highlights: [["01", "Panorama lereng", "Pada cuaca yang lebih cerah, bukit membuka pandangan ke lembah dan kota di bawahnya. Awan, kabut, dan musim menentukan apa yang benar-benar terlihat."], ["02", "Instalasi kayu", "Dokumentasi resmi 2022 menggambarkan land art termasuk tangan Pancawara. Tanyakan instalasi yang sedang dibuka dan patuhi pembatas serta petunjuk petugas."], ["03", "Ruang yang lebih hening", "Di antara titik pandang, carilah jalur teduh dan berhenti tanpa menghalangi sirkulasi atau mengganggu pengunjung lain."]],
  planKicker: "BERKUNJUNG DENGAN PEDULI", planTitle: "Datang dengan <em>rencana sederhana.</em>", plan: [["◐", "Waktu yang sesuai", "Pagi dapat memberi cahaya yang lebih lembut dan ritme yang lebih tenang; lampu kota menarik pengunjung menjelang malam. Pilih sesuai cuaca dan rencana pulang yang aman."], ["⌛", "Waktu di lokasi", "Sediakan sekitar 1–2 jam untuk berjalan santai, memilih titik foto, dan beristirahat. Tambahkan cadangan waktu jika datang saat lebih ramai."], ["↗", "Pijakan & cuaca", "Medan berkontur dan dapat licin. Gunakan alas kaki berdaya cengkeram, bawa air minum, dan tetap di dalam batas platform yang ditandai."]],
  practicalKicker: "CATATAN LAPANGAN PRAKTIS", practicalTitle: "Sebelum roda menyentuh <em>tanah merah.</em>", priceLabel: "REFERENSI MASUK", price: "Konfirmasi<br /><em>biaya terkini</em>", priceNote: "Harga masuk saat ini belum terverifikasi. Tanyakan biaya masuk, parkir, fotografi dan instalasi tertentu secara terpisah sebelum membayar.", cost: ["Parkir kendaraan", "Struktur foto tertentu atau layanan dokumentasi", "Makanan, minuman, dan kebutuhan pribadi"], costNote: "Tanyakan harga serta ketentuan terbaru sebelum menggunakan layanan.", facilityKicker: "PANDUAN FASILITAS NETRAL", facilityTitle: "Yang perlu dicari—<br />tanpa promosi.", facilities: [["WC", "Toilet & kebersihan", "Tanyakan lokasi toilet, ketersediaan air dan akses kepada petugas sebelum mengandalkannya. Bawa tisu pribadi dan buang sampah dengan tertib."], ["P", "Parkir", "Tanyakan ketersediaan, lokasi, kapasitas dan biaya parkir kepada petugas. Ikuti petunjuk di lokasi."], ["☕", "Makan & air minum", "Carilah warung sederhana dan pilihan minuman di sekitar lokasi atau koridor jalan masuk. Panduan ini tidak menyebut usaha tertentu dan tidak memberi peringkat."], ["⌂", "Menginap", "Untuk perjalanan lebih panjang, cari jenis homestay, guesthouse, atau hotel di permukiman sekitar dan koridor Yogyakarta. Konfirmasi jarak, akses, dan ketibaan malam secara langsung."], ["▣", "Belanja & kebutuhan", "Toko kebutuhan harian, pasar, atau gerai yang lebih besar lebih mungkin berada di koridor perkotaan daripada tepi hutan. Siapkan air dan kebutuhan penting sebelum naik."], ["⛽", "BBM & pengisian daya", "Isi bahan bakar dan periksa jarak tempuh kendaraan listrik sebelum memasuki bagian perbukitan. Temukan SPBU serta titik pengisian melalui peta terkini, bukan asumsi dari panduan ini."]],
  accessKicker: "DARI TERMINAL KE LERENG", accessTitle: "Rencana akses yang perlu dibaca <em>pelan-pelan.</em>", routes: [["01", "Dari Bandara Internasional Yogyakarta (YIA)", "Gunakan kereta bandara, DAMRI, transfer resmi, atau layanan bandara terkini menuju kawasan perkotaan Yogyakarta lebih dahulu. Lanjutkan ruas perbukitan dengan kendaraan yang diatur terpisah. Periksa terminal, jam operasi, dan tarif melalui sumber resmi bandara."], ["02", "Dari Adisutjipto atau pusat kota", "Dari pusat kota atau kawasan bandara lama, angkutan kota dapat membantu menuju titik transit yang praktis. Panduan ini tidak menjanjikan angkutan umum langsung ke hutan; rencanakan kendaraan untuk ruas terakhir sebelum meninggalkan kota."], ["03", "Sambungan bus & terminal", "Penumpang bus antarkota dapat tiba di terminal Yogyakarta lalu menggunakan Trans Jogja atau layanan kota lain untuk ruas perkotaan. Dinas Perhubungan DIY menyediakan peta rute dan halte; ruas terakhir ke arah Dlingo tetap memerlukan sambungan terpisah."], ["04", "Taksi, transportasi aplikasi & ojek", "Taksi mobil, layanan aplikasi, dan ojek dapat praktis untuk ruas akhir. Atur opsi pulang lebih awal, bagikan titik jemput yang jelas, dan jangan mengasumsikan ketersediaan kendaraan larut malam di perbukitan."], ["05", "Mobil pribadi, van & kelompok", "Halaman Kalurahan Terong menyebut jalan masuk dapat dilalui kendaraan roda empat dan bus wisata. Jalan tetap memiliki tanjakan serta tikungan; gunakan kendaraan layak jalan dan sesuaikan dengan cuaca, jarak pandang, serta arahan setempat."]], travelLabel: "CATATAN PERJALANAN PULANG", travelTitle: "Atur kendaraan balik sebelum pilihan menyempit.", travelText: "Simpan titik lokasi, jaga daya baterai, bawa pelindung hujan, dan sepakati rencana jemput. Cuaca pegunungan, kualitas sinyal, dan ketersediaan kendaraan dapat berubah tanpa pemberitahuan.",
  nearbyKicker: "KAWASAN DLINGO YANG LEBIH LUAS", nearbyTitle: "Dlingo lebih luas dari satu <em>bingkai.</em>", nearby: [["DI DALAM SABUK PINUS", "Hutan Pinus Mangunan", "Alternatif kawasan pinus untuk berjalan pelan dan berteduh. Susun rute menurut akses, cuaca, dan waktu terbaru, bukan dengan memaksakan seluruh titik kunjung."], ["ARAH PUNCAK", "Puncak Becici", "Titik pandang lain di kawasan Dlingo. Periksa informasi masuk, kondisi jalan, serta pengoperasian masing-masing sebelum menggabungkan kunjungan."], ["KORIDOR PATUK", "Watu Amben", "Koridor Dlingo–Patuk memiliki beberapa titik pandang. Berhenti hanya di tempat yang aman dan jangan mengganggu arus jalan."], ["CATATAN MAKAN NETRAL", "Warung lokal & kebutuhan harian", "Untuk makan atau logistik, cari kategori warung, kedai, pasar, BBM, atau penginapan di sepanjang jalur masuk dan koridor kota. Panduan ini tidak merekomendasikan usaha tertentu."]],
  mapKicker: "TITIK AWAL ANDA", mapTitle: "Simpan lokasi.<br /><em>Jaga arah.</em>", mapText: "Jl. Dlingo–Patuk, Sendangsari, Terong, Dlingo, Bantul 55783. Gunakan pin sebagai orientasi; periksa ulang kondisi jalan, cuaca dan transportasi pada hari perjalanan.", openMap: "Buka di Google Maps", faqKicker: "PERTANYAAN UMUM", faqTitle: "Yang biasa ditanyakan<br />sebelum <em>berangkat.</em>", faq: [["Kapan waktu terbaik berkunjung?", "Pagi dan sore hari umumnya lebih nyaman untuk cahaya serta suhu. Pilih sesuai cuaca, jarak pandang, dan rencana pulang."], ["Berapa lama waktu yang ideal?", "Sekitar 1–2 jam adalah rentang yang masuk akal untuk kunjungan santai. Tambahkan waktu untuk antrean, cuaca, atau rombongan kecil."], ["Apakah WC dan parkir tersedia?", "Tanyakan lokasi toilet, parkir, kapasitas dan biaya kepada petugas. Ketersediaan fasilitas dan layanan foto saat ini belum terverifikasi."], ["Apakah bisa ke sana dengan angkutan umum?", "Angkutan umum dapat membantu ruas bandara-ke-kota atau terminal-ke-kota. Ruas akhir perbukitan Dlingo biasanya membutuhkan kendaraan yang diatur terpisah."], ["Apa yang perlu disiapkan untuk akses?", "Alas kaki stabil, air minum, ponsel terisi, pelindung hujan, serta opsi pulang yang telah dikonfirmasi lebih berguna daripada jadwal yang kaku."], ["Di mana saya bisa makan, membeli kebutuhan, atau menginap?", "Gunakan peta terkini untuk menemukan kategori layanan di permukiman dan koridor kota. Panduan non-profit ini sengaja tidak mendukung penjual tertentu."], ["Kapan jam buka dan berapa harga tiket?", "Google Maps diperiksa 19 Oktober 2026 mencantumkan 08.00–21.00 setiap hari. Ini tidak menjamin akses malam, setiap instalasi atau layanan foto, terutama saat hujan. Harga terkini belum terverifikasi; tanyakan biaya masuk, parkir dan foto secara terpisah."]],
  sourceKicker: "SUMBER & BATAS EDITORIAL", sourceTitle: "Disiapkan untuk membantu merencanakan—<br />bukan menggantikan <em>konfirmasi setempat.</em>", sourceText: "Konteks tempat dan fasilitas yang tercantum mengacu pada halaman publik Kalurahan Terong dan Kabupaten Bantul. Konteks angkutan mengacu pada informasi Trans Jogja Dinas Perhubungan DIY. Artikel Visiting Jogja 2022 mendokumentasikan land art komunitas. Maps diperiksa 19 Oktober 2026 mencantumkan 4,5/5 dari 27.195 ulasan dan 08.00–21.00 setiap hari; ini cuplikan listing, bukan jaminan operasional. Penilaian publik, biaya, jam, cuaca, dan layanan bersifat dinamis.", sourceLast: "Sebelum setiap kunjungan, konfirmasi kondisi keselamatan, akses, harga, cuaca, dan operasional kepada pengelola atau saluran resmi terkait."
};

const attractionSchema = { "@context": "https://schema.org", "@type": "TouristAttraction", name: "Hutan Pinus Pengger", alternateName: "Pinus Pengger", description, url: siteUrl, image: new URL("/assets/pinus-pengger-hand.webp", Astro.site).href, address: { "@type": "PostalAddress", streetAddress: "Jl. Dlingo–Patuk, Sendangsari, Terong, Kec. Dlingo", addressLocality: "Kabupaten Bantul", addressRegion: "Daerah Istimewa Yogyakarta", postalCode: "55783", addressCountry: "ID" }, geo: { "@type": "GeoCoordinates", latitude: -7.8712041, longitude: 110.4595144 }, hasMap: "https://maps.app.goo.gl/4qXJHjvkJ4Ss1Sf36" };
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: c.faq.map(([name, text]) => ({ "@type": "Question", name, acceptedAnswer: { "@type": "Answer", text } })) };
---

<BaseLayout title={title} description={description} lang={lang}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(attractionSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <a class="skip-link" href="#isi">{c.skip}</a>
  <header class="site-header" data-header>
    <a class="brand" href={`${prefix}/`} aria-label={c.brandLabel}><img src="/assets/pinus-pengger-logo.png" alt="" width="64" height="64" /><span><strong>PINUS PENGGER</strong><small>{c.brandSub}</small></span></a>
    <nav aria-label={en ? "Primary navigation" : "Navigasi utama"}><a href="#jelajahi">{c.nav[0]}</a><a href="#kunjungan">{c.nav[1]}</a><a href="#akses">{c.nav[2]}</a><a href="#peta">{c.nav[3]}</a></nav>
    <div class="header-actions"><a class="language-link" href={alternate} hreflang={en ? "id" : "en"}>{c.locale}</a><a class="header-cta" href="#rute">{c.route} <span aria-hidden="true">↗</span></a></div>
  </header>
  <main id="isi">
    <section class="hero" id="beranda" aria-labelledby="hero-title"><div class="hero-photo" role="img" aria-label={en ? "Hutan Pinus Pengger viewpoint with a hand-shaped timber installation" : "Titik pandang Hutan Pinus Pengger dengan instalasi kayu berbentuk tangan"}></div><div class="hero-shade"></div><img class="hero-topo" src="/assets/pinus-pengger-topographic-banner.webp" alt="" aria-hidden="true" /><div class="hero-layout"><p class="eyebrow light"><span></span> {c.heroKicker}</p><h1 id="hero-title" set:html={c.hero}></h1><div class="hero-bottom"><p>{c.heroText}</p><a class="round-link" href="#jelajahi"><span>{c.start}</span><b aria-hidden="true">↓</b></a></div></div><div class="hero-aside"><span>7.8712041°S</span><i></i><span>110.4595144°E</span></div><p class="hero-photo-note">{c.photo}</p></section>
    <section class="intro section" id="jelajahi" aria-labelledby="intro-title"><div class="route-marker" aria-hidden="true"><span>01</span><i></i><b></b></div><div class="intro-copy"><p class="eyebrow"><span></span> {c.introKicker}</p><h2 id="intro-title">{c.introTitle}</h2><p class="lede">{c.introLead}</p><p class="small-copy">{c.introNote}</p></div><figure class="intro-photo frame-photo"><img src="/assets/pinus-pengger-forest.webp" alt={en ? "Pine forest and woven timber installation at Pinus Pengger" : "Hutan pinus dan instalasi anyaman kayu di Pinus Pengger"} loading="lazy" /><figcaption>{c.introCaption}</figcaption></figure><div class="facts" aria-label={en ? "Visit facts" : "Ringkasan kunjungan"}>{c.facts.map(([strong, label]) => <article><strong>{strong}</strong><span>{label}</span></article>)}</div></section>
    <section class="history section" aria-labelledby="history-title"><div class="route-marker" aria-hidden="true"><span>02</span><i></i><b></b></div><div class="history-head"><p class="eyebrow"><span></span> {c.historyKicker}</p><h2 id="history-title" set:html={c.historyTitle}></h2><p>{c.historyIntro}</p></div><div class="history-grid">{c.historyCards.map(([title, text], i) => <article><span>0{i + 1}</span><h3>{title}</h3><p>{text}</p></article>)}</div></section>
    <section class="highlights section" aria-labelledby="highlight-title"><div class="route-marker" aria-hidden="true"><span>03</span><i></i><b></b></div><div class="section-heading"><p class="eyebrow"><span></span> {c.highlightsKicker}</p><h2 id="highlight-title" set:html={c.highlightsTitle}></h2></div><div class="highlight-rail">{c.highlights.map(([number, title, text], i) => <article class:list={["feature", i === 1 ? "feature-text" : "feature-photo", i === 2 && "narrow"]}>{i !== 1 && <img src={i === 0 ? "/assets/pinus-pengger-sunset.webp" : "/assets/pinus-pengger-entrance.webp"} alt={i === 0 ? (en ? "A sunset view from the Pinus Pengger area" : "Panorama senja dari kawasan Pinus Pengger") : (en ? "Approach at Hutan Pinus Pengger" : "Jalur masuk Hutan Pinus Pengger")} loading="lazy" />}<div><span>{number}</span><h3>{title}</h3><p>{text}</p></div>{i === 1 && <i aria-hidden="true">↘</i>}</article>)}</div></section>
    <section class="visit section" id="kunjungan" aria-labelledby="visit-title"><div class="visit-texture" aria-hidden="true"></div><div class="route-marker light-marker" aria-hidden="true"><span>04</span><i></i><b></b></div><div class="visit-heading"><p class="eyebrow light"><span></span> {c.planKicker}</p><h2 id="visit-title" set:html={c.planTitle}></h2></div><div class="visit-grid">{c.plan.map(([icon, title, text]) => <article><span class="icon-sun" aria-hidden="true">{icon}</span><h3>{title}</h3><p>{text}</p></article>)}</div></section>
    <section class="practical section" aria-labelledby="practical-title"><div class="route-marker" aria-hidden="true"><span>05</span><i></i><b></b></div><div class="practical-head"><p class="eyebrow"><span></span> {c.practicalKicker}</p><h2 id="practical-title" set:html={c.practicalTitle}></h2></div><div class="cost-card wood-note"><div><span class="card-label">{c.priceLabel}</span><strong set:html={c.price}></strong><p>{c.priceNote}</p></div><div class="cost-list">{c.cost.map(item => <p><b>+</b> {item}</p>)}<p class="notice">{c.costNote}</p></div></div><div class="facility-head"><p class="eyebrow"><span></span> {c.facilityKicker}</p><h2 set:html={c.facilityTitle}></h2></div><div class="facility-grid">{c.facilities.map(([icon, title, text]) => <article><span>{icon}</span><h3>{title}</h3><p>{text}</p></article>)}</div></section>
    <section class="access section" id="akses" aria-labelledby="access-title"><div class="route-marker" aria-hidden="true"><span>06</span><i></i><b></b></div><div class="access-head"><p class="eyebrow"><span></span> {c.accessKicker}</p><h2 id="access-title" set:html={c.accessTitle}></h2></div><div class="access-layout"><div class="route-list" id="rute">{c.routes.map(([number, title, text]) => <article><span>{number}</span><div><h3>{title}</h3><p>{text}</p></div></article>)}</div><aside class="travel-note"><img src="/assets/pinus-pengger-wood-frame.webp" alt="" aria-hidden="true" /><p class="eyebrow"><span></span> {c.travelLabel}</p><h3>{c.travelTitle}</h3><p>{c.travelText}</p></aside></div></section>
    <section class="nearby section" aria-labelledby="nearby-title"><div class="route-marker" aria-hidden="true"><span>07</span><i></i><b></b></div><div class="nearby-title"><p class="eyebrow"><span></span> {c.nearbyKicker}</p><h2 id="nearby-title" set:html={c.nearbyTitle}></h2></div><div class="nearby-grid">{c.nearby.map(([label, title, text], i) => <article class:list={[i === 3 && "food-card"]}><span>{label}</span><h3>{title}</h3><p>{text}</p></article>)}</div></section>
    <section class="map-section" id="peta" aria-labelledby="map-title"><div class="map-copy"><p class="eyebrow light"><span></span> {c.mapKicker}</p><h2 id="map-title" set:html={c.mapTitle}></h2><p>{c.mapText}</p><a href="https://maps.app.goo.gl/4qXJHjvkJ4Ss1Sf36" target="_blank" rel="noreferrer">{c.openMap} <span aria-hidden="true">↗</span></a></div><iframe title={en ? "Map of Hutan Pinus Pengger" : "Peta Hutan Pinus Pengger"} src="https://www.google.com/maps?q=-7.8712041,110.4595144&amp;output=embed" width="600" height="450" style="border:0" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></section>
    <section class="faq section" aria-labelledby="faq-title"><div class="route-marker" aria-hidden="true"><span>08</span><i></i><b></b></div><div class="faq-header"><p class="eyebrow"><span></span> {c.faqKicker}</p><h2 id="faq-title" set:html={c.faqTitle}></h2></div><div class="faq-list">{c.faq.map(([question, answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
    <section class="source-note" aria-labelledby="source-title"><div><p class="eyebrow"><span></span> {c.sourceKicker}</p><h2 id="source-title" set:html={c.sourceTitle}></h2></div><div><p>{c.sourceText}</p><p><a href="https://terong-bantul.desa.id/first/artikel/1417-MELEPAS-PENAT-DENGAN-KEINDAHAN-HUTAN-PINUS-PENGGER" target="_blank" rel="noreferrer">Kalurahan Terong</a> · <a href="https://petapotensi.bantulkab.go.id/potensi-detail/hutan-pinus-pengger" target="_blank" rel="noreferrer">Kabupaten Bantul</a> · <a href="https://visitingjogja.jogjaprov.go.id/37761/jagad-mangunan-pinus-pengger/" target="_blank" rel="noreferrer">Visiting Jogja · 2022</a> · <a href="https://maps.app.goo.gl/4qXJHjvkJ4Ss1Sf36" target="_blank" rel="noreferrer">Google Maps · 19 October 2026</a> · <a href="https://dishub.jogjaprov.go.id/trans-jogja" target="_blank" rel="noreferrer">Dinas Perhubungan DIY</a></p><p>{c.sourceLast}</p></div></section>
  </main>
  <SiteFooter lang={lang} />
  <CookieBanner lang={lang} />
  <script is:inline>const header = document.querySelector('[data-header]'); window.addEventListener('scroll', () => header?.classList.toggle('is-scrolled', window.scrollY > 48), { passive: true });</script>
</BaseLayout>
